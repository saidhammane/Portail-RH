<odoo>
  <record id="module1_my_model_view_tree" model="ir.ui.view">
    <field name="name">module1.my.model.tree</field>
    <field name="model">my.model</field>
    <field name="arch" type="xml">
      <tree string="Mes enregistrements">
        <field name="name"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="module1_my_model_view_form" model="ir.ui.view">
    <field name="name">module1.my.model.form</field>
    <field name="model">my.model</field>
    <field name="arch" type="xml">
      <form string="Mon enregistrement">
        <header>
          <button
            name="action_confirm"
            type="object"
            string="Confirmer"
            class="btn-primary"
            invisible="state != 'draft'"
          />
          <button
            name="action_done"
            type="object"
            string="Valider"
            class="btn-primary"
            invisible="state != 'confirmed'"
          />
          <button
            name="action_set_draft"
            type="object"
            string="Revenir en brouillon"
            invisible="state not in ('confirmed', 'done')"
          />
          <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="state" readonly="1"/>
            <field name="note"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="module1_my_model_view_search" model="ir.ui.view">
    <field name="name">module1.my.model.search</field>
    <field name="model">my.model</field>
    <field name="arch" type="xml">
      <search string="Mes enregistrements">
        <field name="name"/>
        <filter
          name="group_by_state"
          string="Grouper par statut"
          context="{'group_by': 'state'}"
        />
      </search>
    </field>
  </record>

  <record id="module1_action_my_model" model="ir.actions.act_window">
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="module1_my_model_view_search"/>
  </record>
</odoo>
