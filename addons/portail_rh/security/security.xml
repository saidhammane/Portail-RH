<odoo>
  <record id="module_category_portail_rh" model="ir.module.category">
    <field name="name">Portail RH</field>
    <field name="description">Gestion RH et demandes de déplacement</field>
    <field name="sequence">30</field>
  </record>

  <record id="group_portail_rh_employee" model="res.groups">
    <field name="name">Employé</field>
    <field name="category_id" ref="portail_rh.module_category_portail_rh"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_portail_rh_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="category_id" ref="portail_rh.module_category_portail_rh"/>
    <field name="implied_ids" eval="[(4, ref('portail_rh.group_portail_rh_employee'))]"/>
  </record>

  <record id="group_portail_rh_hr" model="res.groups">
    <field name="name">RH</field>
    <field name="category_id" ref="portail_rh.module_category_portail_rh"/>
    <field
      name="implied_ids"
      eval="[(4, ref('portail_rh.group_portail_rh_manager')), (4, ref('hr.group_hr_user')), (4, ref('hr_attendance.group_hr_attendance_manager'))]"
    />
  </record>
</odoo>
