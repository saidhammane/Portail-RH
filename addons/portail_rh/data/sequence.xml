<odoo>
  <record id="seq_hr_supply_request" model="ir.sequence">
    <field name="name">Demande de fournitures</field>
    <field name="code">hr.supply.request</field>
    <field name="prefix">SRQ/</field>
    <field name="padding">4</field>
    <field name="number_increment">1</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="seq_hr_attestation_request" model="ir.sequence">
    <field name="name">Demande d'attestation RH</field>
    <field name="code">hr.attestation.request</field>
    <field name="prefix">ATT/</field>
    <field name="padding">4</field>
    <field name="number_increment">1</field>
    <field name="company_id" eval="False"/>
  </record>
</odoo>
