<odoo>
  <record id="view_hr_attestation_request_search" model="ir.ui.view">
    <field name="name">hr.attestation.request.search</field>
    <field name="model">hr.attestation.request</field>
    <field name="arch" type="xml">
      <search string="Recherche demandes d'attestations">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="attestation_type"/>
        <field name="state"/>
        <filter name="my_requests" string="Mes demandes" domain="[('employee_id.user_id', '=', uid)]"/>
        <separator/>
        <filter name="state_submitted" string="Soumis" domain="[('state', '=', 'submitted')]"/>
        <filter name="state_approved" string="Approuves" domain="[('state', '=', 'approved')]"/>
        <filter name="state_rejected" string="Refuses" domain="[('state', '=', 'rejected')]"/>
        <filter name="state_done" string="Termines" domain="[('state', '=', 'done')]"/>
        <separator/>
        <filter name="group_by_employee" string="Employe" context="{'group_by': 'employee_id'}"/>
        <filter name="group_by_type" string="Type" context="{'group_by': 'attestation_type'}"/>
        <filter name="group_by_state" string="Etat" context="{'group_by': 'state'}"/>
      </search>
    </field>
  </record>

  <record id="view_hr_attestation_request_tree" model="ir.ui.view">
    <field name="name">hr.attestation.request.tree</field>
    <field name="model">hr.attestation.request</field>
    <field name="arch" type="xml">
      <tree string="Demandes d'attestations">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="department_id"/>
        <field name="attestation_type"/>
        <field name="request_date"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="view_hr_attestation_request_form" model="ir.ui.view">
    <field name="name">hr.attestation.request.form</field>
    <field name="model">hr.attestation.request</field>
    <field name="arch" type="xml">
      <form string="Demande d'attestation RH">
        <header>
          <button name="action_submit" type="object" string="Soumettre" class="btn-primary" invisible="state != 'draft'"/>
          <button name="action_approve" type="object" string="Approuver" class="btn-primary" invisible="state != 'submitted' or not can_approve"/>
          <button name="action_reject" type="object" string="Refuser" invisible="state != 'submitted' or not can_approve"/>
          <button name="action_done" type="object" string="Terminer" class="btn-primary" invisible="state != 'approved' or not can_approve"/>
          <button name="action_set_draft" type="object" string="Remettre en brouillon" invisible="state not in ('submitted', 'rejected')"/>
          <button
            name="action_print_attestation"
            type="object"
            string="Imprimer l'attestation"
            invisible="state not in ('approved', 'done')"
          />
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,done"/>
        </header>
        <sheet>
          <field name="can_approve" invisible="1"/>
          <group>
            <group string="Employe">
              <field name="name" readonly="1"/>
              <field
                name="employee_id"
                domain="[] if can_approve else [('user_id', '=', uid)]"
                readonly="state != 'draft' and not can_approve"
              />
              <field name="department_id" readonly="1"/>
            </group>
            <group string="Attestation">
              <field name="attestation_type" readonly="state != 'draft' and not can_approve"/>
              <field name="request_date" readonly="state != 'draft' and not can_approve"/>
            </group>
          </group>
          <group string="Motif">
            <field name="reason" readonly="state != 'draft' and not can_approve"/>
          </group>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>
</odoo>
