<odoo>
  <template id="portal_breadcrumbs_portail_rh" inherit_id="portal.portal_breadcrumbs" priority="40">
    <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
      <li
        t-if="page_name in ('travel_requests', 'travel_request_detail', 'travel_request_new')"
        t-attf-class="breadcrumb-item #{'active' if page_name == 'travel_requests' else ''}"
      >
        <a t-if="page_name != 'travel_requests'" href="/my/travel_requests">Mes deplacements</a>
        <t t-else="">Mes deplacements</t>
      </li>
      <li t-if="page_name == 'travel_request_new'" class="breadcrumb-item active">Nouvelle demande</li>
      <li t-if="page_name == 'travel_request_detail'" class="breadcrumb-item active">
        <t t-out="travel_request.name"/>
      </li>
      <li
        t-if="page_name in ('supply_requests', 'supply_request_detail', 'supply_request_new')"
        t-attf-class="breadcrumb-item #{'active' if page_name == 'supply_requests' else ''}"
      >
        <a t-if="page_name != 'supply_requests'" href="/my/supply_requests">Mes fournitures</a>
        <t t-else="">Mes fournitures</t>
      </li>
      <li t-if="page_name == 'supply_request_new'" class="breadcrumb-item active">Nouvelle demande</li>
      <li t-if="page_name == 'supply_request_detail'" class="breadcrumb-item active">
        <t t-out="supply_request.name"/>
      </li>
    </xpath>
  </template>

  <template id="portal_my_home_portail_rh" inherit_id="portal.portal_my_home" priority="40">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
      <t t-set="portal_client_category_enable" t-value="True"/>
    </xpath>
    <div id="portal_client_category" position="inside">
      <t t-call="portal.portal_docs_entry">
        <t t-set="icon" t-value="'/sale/static/src/img/bag.svg'"/>
        <t t-set="title">Mes deplacements</t>
        <t t-set="url" t-value="'/my/travel_requests'"/>
        <t t-set="text">Suivez et creez vos demandes de deplacement</t>
        <t t-set="placeholder_count" t-value="'travel_request_count'"/>
      </t>
      <t t-call="portal.portal_docs_entry">
        <t t-set="icon" t-value="'/project/static/src/img/tasks.svg'"/>
        <t t-set="title">Mes fournitures</t>
        <t t-set="url" t-value="'/my/supply_requests'"/>
        <t t-set="text">Suivez et creez vos demandes de fournitures</t>
        <t t-set="placeholder_count" t-value="'supply_request_count'"/>
      </t>
    </div>
  </template>

  <template id="portal_my_travel_requests" name="Mes deplacements">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>
      <t t-set="badge_classes" t-value="{'draft': 'text-bg-secondary', 'submitted': 'text-bg-primary', 'approved': 'text-bg-success', 'rejected': 'text-bg-danger', 'done': 'text-bg-dark'}"/>
      <t t-call="portal.portal_searchbar">
        <t t-set="title" t-value="portal_list_title"/>
        <a class="btn btn-primary" t-att-href="portal_new_route">Nouvelle demande</a>
      </t>

      <div t-if="success_message" class="alert alert-success" role="alert">
        <t t-out="success_message"/>
      </div>
      <div t-if="not travel_requests" class="alert alert-warning" role="alert">
        <t t-out="portal_empty_message"/>
      </div>
      <t t-elif="travel_requests" t-call="portal.portal_table">
        <thead>
          <tr class="active">
            <th>Reference</th>
            <th>Destination</th>
            <th class="text-end">Date debut</th>
            <th class="text-end">Date fin</th>
            <th class="text-end">Etat</th>
          </tr>
        </thead>
        <tbody>
          <t t-foreach="travel_requests" t-as="travel_request">
            <tr>
              <td>
                <a t-att-href="'/my/travel_requests/%s' % travel_request.id">
                  <t t-out="travel_request.name"/>
                </a>
              </td>
              <td><t t-out="travel_request.destination"/></td>
              <td class="text-end">
                <span t-field="travel_request.date_from" t-options="{'widget': 'date'}"/>
              </td>
              <td class="text-end">
                <span t-field="travel_request.date_to" t-options="{'widget': 'date'}"/>
              </td>
              <td class="text-end">
                <span
                  class="badge rounded-pill"
                  t-att-class="badge_classes.get(travel_request.state, 'text-bg-light')"
                >
                  <t t-out="portal_state_labels.get(travel_request.state, travel_request.state)"/>
                </span>
              </td>
            </tr>
          </t>
        </tbody>
      </t>
    </t>
  </template>

  <template id="portal_travel_request_detail" name="Detail demande deplacement">
    <t t-call="portal.portal_layout">
      <t t-set="badge_classes" t-value="{'draft': 'text-bg-secondary', 'submitted': 'text-bg-primary', 'approved': 'text-bg-success', 'rejected': 'text-bg-danger', 'done': 'text-bg-dark'}"/>

      <div class="mb-4">
        <h2 class="mb-1"><t t-out="travel_request.name"/></h2>
        <p class="text-muted mb-0">Demande de deplacement</p>
      </div>

      <div t-if="success_message" class="alert alert-success" role="alert">
        <t t-out="success_message"/>
      </div>
      <div t-if="error_message" class="alert alert-danger" role="alert">
        <t t-out="error_message"/>
      </div>

      <div class="row g-4">
        <div class="col-lg-8">
          <t t-call="portal.portal_record_layout">
            <t t-set="card_header">
              <h5 class="mb-0">Informations generales</h5>
            </t>
            <t t-set="card_body">
              <div class="row g-3">
                <div class="col-md-6">
                  <strong>Employe</strong>
                  <div><t t-out="travel_request.employee_id.name"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Destination</strong>
                  <div><t t-out="travel_request.destination"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Date debut</strong>
                  <div><span t-field="travel_request.date_from" t-options="{'widget': 'date'}"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Date fin</strong>
                  <div><span t-field="travel_request.date_to" t-options="{'widget': 'date'}"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Duree</strong>
                  <div><t t-out="travel_request.duration_days"/> jour(s)</div>
                </div>
                <div class="col-md-6">
                  <strong>Cout estime</strong>
                  <div><t t-out="travel_request.estimated_cost"/></div>
                </div>
              </div>
            </t>
          </t>

          <t t-call="portal.portal_record_layout" t-if="travel_request.purpose">
            <t t-set="card_header">
              <h5 class="mb-0">Motif</h5>
            </t>
            <t t-set="card_body">
              <p class="mb-0"><t t-out="travel_request.purpose"/></p>
            </t>
          </t>
        </div>

        <t t-call="portal.portal_record_sidebar">
          <t t-set="classes" t-value="'col-lg-4'"/>
          <t t-set="title">
            <div class="w-100">
              <h4 class="mb-2">Statut</h4>
              <span
                class="badge rounded-pill"
                t-att-class="badge_classes.get(travel_request.state, 'text-bg-light')"
              >
                <t t-out="portal_state_labels.get(travel_request.state, travel_request.state)"/>
              </span>
            </div>
          </t>
          <t t-set="entries">
            <div class="list-group mb-3">
              <div class="list-group-item d-flex justify-content-between">
                <span>Reference</span>
                <strong><t t-out="travel_request.name"/></strong>
              </div>
              <div class="list-group-item d-flex justify-content-between">
                <span>Destination</span>
                <strong><t t-out="travel_request.destination"/></strong>
              </div>
              <div class="list-group-item d-flex justify-content-between">
                <span>Date debut</span>
                <strong><span t-field="travel_request.date_from" t-options="{'widget': 'date'}"/></strong>
              </div>
              <div class="list-group-item d-flex justify-content-between">
                <span>Date fin</span>
                <strong><span t-field="travel_request.date_to" t-options="{'widget': 'date'}"/></strong>
              </div>
            </div>
            <div class="d-grid gap-2">
              <form
                t-if="travel_request.state == 'draft'"
                t-att-action="portal_submit_route % travel_request.id"
                method="post"
              >
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <button type="submit" class="btn btn-primary w-100">Soumettre</button>
              </form>
              <a class="btn btn-outline-secondary" href="/my/travel_requests">Retour a la liste</a>
            </div>
          </t>
        </t>
      </div>
    </t>
  </template>

  <template id="portal_new_travel_request" name="Nouvelle demande deplacement">
    <t t-call="portal.portal_layout">
      <div class="mb-4">
        <h2 class="mb-1"><t t-out="portal_new_title"/></h2>
        <p class="text-muted mb-0">Creez votre demande avant soumission au manager.</p>
      </div>

      <div t-if="error_message" class="alert alert-danger" role="alert">
        <t t-out="error_message"/>
      </div>

      <t t-call="portal.portal_record_layout">
        <t t-set="card_body">
          <form action="/my/travel_requests/create" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label" for="travel_destination">Destination</label>
                <input
                  id="travel_destination"
                  type="text"
                  name="destination"
                  class="form-control"
                  required="required"
                  t-att-value="form_values.get('destination', '')"
                />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="travel_date_from">Date debut</label>
                <input
                  id="travel_date_from"
                  type="date"
                  name="date_from"
                  class="form-control"
                  required="required"
                  t-att-value="form_values.get('date_from', '')"
                />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="travel_date_to">Date fin</label>
                <input
                  id="travel_date_to"
                  type="date"
                  name="date_to"
                  class="form-control"
                  required="required"
                  t-att-value="form_values.get('date_to', '')"
                />
              </div>
              <div class="col-12">
                <label class="form-label" for="travel_purpose">Motif</label>
                <textarea id="travel_purpose" name="purpose" class="form-control" rows="4"><t t-out="form_values.get('purpose', '')"/></textarea>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="travel_estimated_cost">Cout estime</label>
                <input
                  id="travel_estimated_cost"
                  type="number"
                  step="0.01"
                  min="0"
                  name="estimated_cost"
                  class="form-control"
                  t-att-value="form_values.get('estimated_cost', '')"
                />
              </div>
            </div>
            <div class="d-flex justify-content-between mt-4">
              <a class="btn btn-outline-secondary" href="/my/travel_requests">Retour a la liste</a>
              <button type="submit" class="btn btn-primary">Creer la demande</button>
            </div>
          </form>
        </t>
      </t>
    </t>
  </template>

  <template id="portal_my_supply_requests" name="Mes fournitures">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>
      <t t-set="badge_classes" t-value="{'draft': 'text-bg-secondary', 'submitted': 'text-bg-primary', 'approved': 'text-bg-success', 'rejected': 'text-bg-danger', 'done': 'text-bg-dark'}"/>
      <t t-call="portal.portal_searchbar">
        <t t-set="title" t-value="portal_list_title"/>
        <a class="btn btn-primary" t-att-href="portal_new_route">Nouvelle demande</a>
      </t>

      <div t-if="success_message" class="alert alert-success" role="alert">
        <t t-out="success_message"/>
      </div>
      <div t-if="not supply_requests" class="alert alert-warning" role="alert">
        <t t-out="portal_empty_message"/>
      </div>
      <t t-elif="supply_requests" t-call="portal.portal_table">
        <thead>
          <tr class="active">
            <th>Reference</th>
            <th>Article</th>
            <th class="text-end">Quantite</th>
            <th class="text-end">Cout estime</th>
            <th class="text-end">Date creation</th>
            <th class="text-end">Etat</th>
          </tr>
        </thead>
        <tbody>
          <t t-foreach="supply_requests" t-as="supply_request">
            <tr>
              <td>
                <a t-att-href="'/my/supply_requests/%s' % supply_request.id">
                  <t t-out="supply_request.name"/>
                </a>
              </td>
              <td><t t-out="supply_request.item_name"/></td>
              <td class="text-end"><t t-out="supply_request.quantity"/></td>
              <td class="text-end"><t t-out="supply_request.estimated_cost"/></td>
              <td class="text-end">
                <span t-field="supply_request.create_date" t-options="{'widget': 'date'}"/>
              </td>
              <td class="text-end">
                <span
                  class="badge rounded-pill"
                  t-att-class="badge_classes.get(supply_request.state, 'text-bg-light')"
                >
                  <t t-out="portal_state_labels.get(supply_request.state, supply_request.state)"/>
                </span>
              </td>
            </tr>
          </t>
        </tbody>
      </t>
    </t>
  </template>

  <template id="portal_supply_request_detail" name="Detail demande fourniture">
    <t t-call="portal.portal_layout">
      <t t-set="badge_classes" t-value="{'draft': 'text-bg-secondary', 'submitted': 'text-bg-primary', 'approved': 'text-bg-success', 'rejected': 'text-bg-danger', 'done': 'text-bg-dark'}"/>

      <div class="mb-4">
        <h2 class="mb-1"><t t-out="supply_request.name"/></h2>
        <p class="text-muted mb-0">Demande de fournitures</p>
      </div>

      <div t-if="success_message" class="alert alert-success" role="alert">
        <t t-out="success_message"/>
      </div>
      <div t-if="error_message" class="alert alert-danger" role="alert">
        <t t-out="error_message"/>
      </div>

      <div class="row g-4">
        <div class="col-lg-8">
          <t t-call="portal.portal_record_layout">
            <t t-set="card_header">
              <h5 class="mb-0">Informations generales</h5>
            </t>
            <t t-set="card_body">
              <div class="row g-3">
                <div class="col-md-6">
                  <strong>Employe</strong>
                  <div><t t-out="supply_request.employee_id.name"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Article</strong>
                  <div><t t-out="supply_request.item_name"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Quantite</strong>
                  <div><t t-out="supply_request.quantity"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Cout estime</strong>
                  <div><t t-out="supply_request.estimated_cost"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Departement</strong>
                  <div><t t-out="supply_request.department_id.name or '-'"/></div>
                </div>
                <div class="col-md-6">
                  <strong>Date creation</strong>
                  <div><span t-field="supply_request.create_date" t-options="{'widget': 'date'}"/></div>
                </div>
              </div>
            </t>
          </t>

          <t t-call="portal.portal_record_layout" t-if="supply_request.description or supply_request.reason">
            <t t-set="card_header">
              <h5 class="mb-0">Justification</h5>
            </t>
            <t t-set="card_body">
              <div class="row g-3">
                <div class="col-12" t-if="supply_request.description">
                  <strong>Description</strong>
                  <p class="mb-0 mt-1"><t t-out="supply_request.description"/></p>
                </div>
                <div class="col-12" t-if="supply_request.reason">
                  <strong>Motif</strong>
                  <p class="mb-0 mt-1"><t t-out="supply_request.reason"/></p>
                </div>
              </div>
            </t>
          </t>
        </div>

        <t t-call="portal.portal_record_sidebar">
          <t t-set="classes" t-value="'col-lg-4'"/>
          <t t-set="title">
            <div class="w-100">
              <h4 class="mb-2">Statut</h4>
              <span
                class="badge rounded-pill"
                t-att-class="badge_classes.get(supply_request.state, 'text-bg-light')"
              >
                <t t-out="portal_state_labels.get(supply_request.state, supply_request.state)"/>
              </span>
            </div>
          </t>
          <t t-set="entries">
            <div class="list-group mb-3">
              <div class="list-group-item d-flex justify-content-between">
                <span>Reference</span>
                <strong><t t-out="supply_request.name"/></strong>
              </div>
              <div class="list-group-item d-flex justify-content-between">
                <span>Article</span>
                <strong><t t-out="supply_request.item_name"/></strong>
              </div>
              <div class="list-group-item d-flex justify-content-between">
                <span>Quantite</span>
                <strong><t t-out="supply_request.quantity"/></strong>
              </div>
              <div class="list-group-item d-flex justify-content-between">
                <span>Departement</span>
                <strong><t t-out="supply_request.department_id.name or '-'"/></strong>
              </div>
            </div>
            <div class="d-grid gap-2">
              <form
                t-if="supply_request.state == 'draft'"
                t-att-action="portal_submit_route % supply_request.id"
                method="post"
              >
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <button type="submit" class="btn btn-primary w-100">Soumettre</button>
              </form>
              <a class="btn btn-outline-secondary" href="/my/supply_requests">Retour a la liste</a>
            </div>
          </t>
        </t>
      </div>
    </t>
  </template>

  <template id="portal_new_supply_request" name="Nouvelle demande fourniture">
    <t t-call="portal.portal_layout">
      <div class="mb-4">
        <h2 class="mb-1"><t t-out="portal_new_title"/></h2>
        <p class="text-muted mb-0">Creez votre demande avant soumission au manager.</p>
      </div>

      <div t-if="error_message" class="alert alert-danger" role="alert">
        <t t-out="error_message"/>
      </div>

      <t t-call="portal.portal_record_layout">
        <t t-set="card_body">
          <form action="/my/supply_requests/create" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <div class="row g-3">
              <div class="col-12">
                <label class="form-label" for="supply_item_name">Article</label>
                <input
                  id="supply_item_name"
                  type="text"
                  name="item_name"
                  class="form-control"
                  required="required"
                  t-att-value="form_values.get('item_name', '')"
                />
              </div>
              <div class="col-12">
                <label class="form-label" for="supply_description">Description</label>
                <textarea id="supply_description" name="description" class="form-control" rows="4"><t t-out="form_values.get('description', '')"/></textarea>
              </div>
              <div class="col-md-6">
                <label class="form-label" for="supply_quantity">Quantite</label>
                <input
                  id="supply_quantity"
                  type="number"
                  step="0.01"
                  min="0.01"
                  name="quantity"
                  class="form-control"
                  required="required"
                  t-att-value="form_values.get('quantity', '1')"
                />
              </div>
              <div class="col-md-6">
                <label class="form-label" for="supply_estimated_cost">Cout estime</label>
                <input
                  id="supply_estimated_cost"
                  type="number"
                  step="0.01"
                  min="0"
                  name="estimated_cost"
                  class="form-control"
                  t-att-value="form_values.get('estimated_cost', '')"
                />
              </div>
              <div class="col-12">
                <label class="form-label" for="supply_reason">Motif</label>
                <textarea id="supply_reason" name="reason" class="form-control" rows="4"><t t-out="form_values.get('reason', '')"/></textarea>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-4">
              <a class="btn btn-outline-secondary" href="/my/supply_requests">Retour a la liste</a>
              <button type="submit" class="btn btn-primary">Creer la demande</button>
            </div>
          </form>
        </t>
      </t>
    </t>
  </template>
</odoo>
