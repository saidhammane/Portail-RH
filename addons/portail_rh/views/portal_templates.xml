<odoo>
  <template id="portal_breadcrumbs_portail_rh" inherit_id="portal.portal_breadcrumbs" priority="40">
    <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
      <li
        t-if="page_name in ('travel_requests', 'travel_request_detail', 'travel_request_new')"
        t-attf-class="breadcrumb-item #{'active' if page_name == 'travel_requests' else ''}"
      >
        <a t-if="page_name != 'travel_requests'" href="/my/travel_requests">Mes deplacements</a>
        <t t-else="">Mes deplacements</t>
      </li>
      <li t-if="page_name == 'travel_request_new'" class="breadcrumb-item active">Nouvelle demande</li>
      <li t-if="page_name == 'travel_request_detail'" class="breadcrumb-item active">
        <t t-out="travel_request.name"/>
      </li>
      <li
        t-if="page_name in ('supply_requests', 'supply_request_detail', 'supply_request_new')"
        t-attf-class="breadcrumb-item #{'active' if page_name == 'supply_requests' else ''}"
      >
        <a t-if="page_name != 'supply_requests'" href="/my/supply_requests">Mes fournitures</a>
        <t t-else="">Mes fournitures</t>
      </li>
      <li t-if="page_name == 'supply_request_new'" class="breadcrumb-item active">Nouvelle demande</li>
      <li t-if="page_name == 'supply_request_detail'" class="breadcrumb-item active">
        <t t-out="supply_request.name"/>
      </li>
      <li
        t-if="page_name in ('attestation_requests', 'attestation_request_detail', 'attestation_request_new')"
        t-attf-class="breadcrumb-item #{'active' if page_name == 'attestation_requests' else ''}"
      >
        <a t-if="page_name != 'attestation_requests'" href="/my/attestation_requests">Mes attestations</a>
        <t t-else="">Mes attestations</t>
      </li>
      <li t-if="page_name == 'attestation_request_new'" class="breadcrumb-item active">Nouvelle demande</li>
      <li t-if="page_name == 'attestation_request_detail'" class="breadcrumb-item active">
        <t t-out="attestation_request.name"/>
      </li>
      <li t-if="page_name in ('onboarding', 'onboarding_checklist')" class="breadcrumb-item active">
        <a t-if="page_name == 'onboarding_checklist'" href="/my/onboarding">Assistant d'integration</a>
        <t t-else="">Assistant d'integration</t>
      </li>
      <li t-if="page_name == 'onboarding_checklist'" class="breadcrumb-item active">Checklist</li>
    </xpath>
  </template>

  <template id="portal_my_home_portail_rh" inherit_id="portal.portal_my_home" priority="40">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
      <t t-set="portal_client_category_enable" t-value="True"/>
    </xpath>
    <div id="portal_client_category" position="inside">
      <t t-call="portal.portal_docs_entry">
        <t t-set="icon" t-value="'/portail_rh/static/description/icon.png'"/>
        <t t-set="title">Mes deplacements</t>
        <t t-set="url" t-value="'/my/travel_requests'"/>
        <t t-set="text">Suivez et creez vos demandes de deplacement</t>
        <t t-set="placeholder_count" t-value="'travel_request_count'"/>
      </t>
      <t t-call="portal.portal_docs_entry">
        <t t-set="icon" t-value="'/portail_rh/static/description/icon.png'"/>
        <t t-set="title">Mes fournitures</t>
        <t t-set="url" t-value="'/my/supply_requests'"/>
        <t t-set="text">Suivez et creez vos demandes de fournitures</t>
        <t t-set="placeholder_count" t-value="'supply_request_count'"/>
      </t>
      <t t-call="portal.portal_docs_entry">
        <t t-set="icon" t-value="'/portail_rh/static/description/icon.png'"/>
        <t t-set="title">Mes attestations</t>
        <t t-set="url" t-value="'/my/attestation_requests'"/>
        <t t-set="text">Demandez et telechargez vos attestations RH</t>
        <t t-set="placeholder_count" t-value="'attestation_request_count'"/>
      </t>
      <t t-call="portal.portal_docs_entry">
        <t t-set="icon" t-value="'/portail_rh/static/description/icon.png'"/>
        <t t-set="title">Assistant d'integration</t>
        <t t-set="url" t-value="'/my/onboarding'"/>
        <t t-set="text">Posez vos questions avec des sources et suivez votre checklist</t>
        <t t-set="placeholder_count" t-value="'onboarding_task_count'"/>
      </t>
    </div>
  </template>

  <template id="portal_request_badge" name="Statut demande RH">
    <t t-set="badge_classes" t-value="{'draft': 'text-bg-secondary', 'submitted': 'text-bg-primary', 'approved': 'text-bg-success', 'rejected': 'text-bg-danger', 'done': 'text-bg-dark'}"/>
    <span
      class="badge rounded-pill"
      t-att-class="badge_classes.get(portal_record.state, 'text-bg-light')"
    >
      <t t-out="portal_state_labels.get(portal_record.state, portal_record.state)"/>
    </span>
  </template>

  <template id="portal_request_list" name="Liste demandes RH">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>
      <t t-call="portal.portal_searchbar">
        <t
          t-set="title"
          t-value="'Mes deplacements' if request_type == 'travel' else ('Mes fournitures' if request_type == 'supply' else 'Mes attestations')"
        />
        <a class="btn btn-primary" t-att-href="default_url + '/new'">Nouvelle demande</a>
      </t>

      <div t-if="success_message" class="alert alert-success" role="alert">
        <t t-out="success_message"/>
      </div>
      <div t-if="not portal_records" class="alert alert-warning" role="alert">
        Aucune demande pour le moment.
      </div>
      <t t-if="portal_records" t-call="portal.portal_table">
        <thead>
          <tr class="active">
            <th>Reference</th>
            <th t-if="request_type == 'travel'">Destination</th>
            <th t-elif="request_type == 'supply'">Article</th>
            <th t-else="">Type d'attestation</th>
            <th t-if="request_type == 'supply'" class="text-end">Quantite</th>
            <th t-if="request_type == 'travel'" class="text-end">Date debut</th>
            <th t-if="request_type == 'travel'" class="text-end">Date fin</th>
            <th t-elif="request_type == 'supply'" class="text-end">Date creation</th>
            <th t-else="" class="text-end">Date de demande</th>
            <th t-if="request_type == 'supply'" class="text-end">Cout estime</th>
            <th class="text-end">Etat</th>
          </tr>
        </thead>
        <tbody>
          <t t-foreach="portal_records" t-as="portal_record">
            <tr>
              <td>
                <a t-att-href="'%s/%s' % (default_url, portal_record.id)">
                  <t t-out="portal_record.name"/>
                </a>
              </td>
              <td t-if="request_type == 'travel'"><t t-out="portal_record.destination"/></td>
              <td t-elif="request_type == 'supply'"><t t-out="portal_record.item_name"/></td>
              <td t-else="">
                <t t-out="attestation_type_labels.get(portal_record.attestation_type, portal_record.attestation_type)"/>
              </td>
              <td t-if="request_type == 'supply'" class="text-end">
                <t t-out="portal_record.quantity"/>
              </td>
              <td t-if="request_type == 'travel'" class="text-end">
                <span t-field="portal_record.date_from" t-options="{'widget': 'date'}"/>
              </td>
              <td t-if="request_type == 'travel'" class="text-end">
                <span t-field="portal_record.date_to" t-options="{'widget': 'date'}"/>
              </td>
              <td t-elif="request_type == 'supply'" class="text-end">
                <span t-field="portal_record.create_date" t-options="{'widget': 'date'}"/>
              </td>
              <td t-else="" class="text-end">
                <span t-field="portal_record.request_date" t-options="{'widget': 'date'}"/>
              </td>
              <td t-if="request_type == 'supply'" class="text-end">
                <t t-out="portal_record.estimated_cost"/>
              </td>
              <td class="text-end"><t t-call="portail_rh.portal_request_badge"/></td>
            </tr>
          </t>
        </tbody>
      </t>
    </t>
  </template>

  <template id="portal_request_detail" name="Detail demande RH">
    <t t-call="portal.portal_layout">
      <div class="mb-4">
        <h2 class="mb-1"><t t-out="portal_record.name"/></h2>
        <p class="text-muted mb-0">
          <t t-if="request_type == 'travel'">Demande de deplacement</t>
          <t t-elif="request_type == 'supply'">Demande de fournitures</t>
          <t t-else="">Demande d'attestation RH</t>
        </p>
      </div>
      <div t-if="success_message" class="alert alert-success" role="alert">
        <t t-out="success_message"/>
      </div>
      <div t-if="error_message" class="alert alert-danger" role="alert">
        <t t-out="error_message"/>
      </div>

      <div class="row g-4">
        <div class="col-lg-8">
          <t t-call="portal.portal_record_layout">
            <t t-set="card_header"><h5 class="mb-0">Informations generales</h5></t>
            <t t-set="card_body">
              <div class="row g-3">
                <div class="col-md-6">
                  <strong>Employe</strong>
                  <div><t t-out="portal_record.employee_id.name"/></div>
                </div>
                <t t-if="request_type == 'travel'">
                  <div class="col-md-6">
                    <strong>Destination</strong>
                    <div><t t-out="portal_record.destination"/></div>
                  </div>
                  <div class="col-md-6">
                    <strong>Date debut</strong>
                    <div><span t-field="portal_record.date_from" t-options="{'widget': 'date'}"/></div>
                  </div>
                  <div class="col-md-6">
                    <strong>Date fin</strong>
                    <div><span t-field="portal_record.date_to" t-options="{'widget': 'date'}"/></div>
                  </div>
                  <div class="col-md-6">
                    <strong>Duree</strong>
                    <div><t t-out="portal_record.duration_days"/> jour(s)</div>
                  </div>
                </t>
                <t t-elif="request_type == 'supply'">
                  <div class="col-md-6">
                    <strong>Article</strong>
                    <div><t t-out="portal_record.item_name"/></div>
                  </div>
                  <div class="col-md-6">
                    <strong>Quantite</strong>
                    <div><t t-out="portal_record.quantity"/></div>
                  </div>
                  <div class="col-md-6">
                    <strong>Departement</strong>
                    <div><t t-out="portal_record.department_id.name or '-'"/></div>
                  </div>
                  <div class="col-md-6">
                    <strong>Date creation</strong>
                    <div><span t-field="portal_record.create_date" t-options="{'widget': 'date'}"/></div>
                  </div>
                </t>
                <t t-else="">
                  <div class="col-md-6">
                    <strong>Departement</strong>
                    <div><t t-out="portal_record.department_id.name or '-'"/></div>
                  </div>
                  <div class="col-md-6">
                    <strong>Type d'attestation</strong>
                    <div><t t-out="attestation_type_labels.get(portal_record.attestation_type, portal_record.attestation_type)"/></div>
                  </div>
                  <div class="col-md-6">
                    <strong>Date de demande</strong>
                    <div><span t-field="portal_record.request_date" t-options="{'widget': 'date'}"/></div>
                  </div>
                </t>
                <div t-if="request_type in ('travel', 'supply')" class="col-md-6">
                  <strong>Cout estime</strong>
                  <div><t t-out="portal_record.estimated_cost"/></div>
                </div>
              </div>
            </t>
          </t>

          <t
            t-call="portal.portal_record_layout"
            t-if="(request_type == 'travel' and portal_record.purpose) or (request_type == 'supply' and (portal_record.description or portal_record.reason)) or (request_type == 'attestation' and portal_record.reason)"
          >
            <t t-set="card_header"><h5 class="mb-0">Justification</h5></t>
            <t t-set="card_body">
              <p t-if="request_type == 'travel'" class="mb-0"><t t-out="portal_record.purpose"/></p>
              <div t-elif="request_type == 'supply'">
                <p t-if="portal_record.description"><strong>Description</strong><br/><t t-out="portal_record.description"/></p>
                <p t-if="portal_record.reason" class="mb-0"><strong>Motif</strong><br/><t t-out="portal_record.reason"/></p>
              </div>
              <p t-else="" class="mb-0"><t t-out="portal_record.reason"/></p>
            </t>
          </t>
        </div>

        <t t-call="portal.portal_record_sidebar">
          <t t-set="classes" t-value="'col-lg-4'"/>
          <t t-set="title">
            <div class="w-100">
              <h4 class="mb-2">Statut</h4>
              <t t-call="portail_rh.portal_request_badge"/>
            </div>
          </t>
          <t t-set="entries">
            <div class="list-group mb-3">
              <div class="list-group-item d-flex justify-content-between">
                <span>Reference</span><strong><t t-out="portal_record.name"/></strong>
              </div>
              <div class="list-group-item d-flex justify-content-between">
                <span t-if="request_type == 'travel'">Destination</span>
                <span t-elif="request_type == 'supply'">Article</span>
                <span t-else="">Type</span>
                <strong>
                  <t t-if="request_type == 'travel'" t-out="portal_record.destination"/>
                  <t t-elif="request_type == 'supply'" t-out="portal_record.item_name"/>
                  <t t-else="" t-out="attestation_type_labels.get(portal_record.attestation_type, portal_record.attestation_type)"/>
                </strong>
              </div>
            </div>
            <div class="d-grid gap-2">
              <form
                t-if="portal_record.state == 'draft'"
                t-att-action="'%s/%s/submit' % (default_url, portal_record.id)"
                method="post"
              >
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <button type="submit" class="btn btn-primary w-100">Soumettre</button>
              </form>
              <a
                t-if="request_type == 'attestation' and portal_record.state in ('approved', 'done')"
                class="btn btn-success"
                t-att-href="'%s/%s/pdf' % (default_url, portal_record.id)"
              >Telecharger l'attestation PDF</a>
              <a class="btn btn-outline-secondary" t-att-href="default_url">Retour a la liste</a>
            </div>
          </t>
        </t>
      </div>
    </t>
  </template>

  <template id="portal_request_form" name="Creation demande RH">
    <t t-call="portal.portal_layout">
      <div class="mb-4">
        <h2 class="mb-1">
          <t t-if="request_type == 'travel'">Nouvelle demande de deplacement</t>
          <t t-elif="request_type == 'supply'">Nouvelle demande de fournitures</t>
          <t t-else="">Nouvelle demande d'attestation</t>
        </h2>
        <p class="text-muted mb-0">Creez votre demande avant soumission au manager.</p>
      </div>
      <div t-if="error_message" class="alert alert-danger" role="alert">
        <t t-out="error_message"/>
      </div>
      <t t-call="portal.portal_record_layout">
        <t t-set="card_body">
          <form t-att-action="default_url + '/create'" method="post">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <div class="row g-3">
              <t t-if="request_type == 'travel'">
                <div class="col-12">
                  <label class="form-label" for="travel_destination">Destination</label>
                  <input id="travel_destination" type="text" name="destination" class="form-control" required="required" t-att-value="form_values.get('destination', '')"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="travel_date_from">Date debut</label>
                  <input id="travel_date_from" type="date" name="date_from" class="form-control" required="required" t-att-value="form_values.get('date_from', '')"/>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="travel_date_to">Date fin</label>
                  <input id="travel_date_to" type="date" name="date_to" class="form-control" required="required" t-att-value="form_values.get('date_to', '')"/>
                </div>
                <div class="col-12">
                  <label class="form-label" for="travel_purpose">Motif</label>
                  <textarea id="travel_purpose" name="purpose" class="form-control" rows="4"><t t-out="form_values.get('purpose', '')"/></textarea>
                </div>
              </t>
              <t t-elif="request_type == 'supply'">
                <div class="col-12">
                  <label class="form-label" for="supply_item_name">Article</label>
                  <input id="supply_item_name" type="text" name="item_name" class="form-control" required="required" t-att-value="form_values.get('item_name', '')"/>
                </div>
                <div class="col-12">
                  <label class="form-label" for="supply_description">Description</label>
                  <textarea id="supply_description" name="description" class="form-control" rows="4"><t t-out="form_values.get('description', '')"/></textarea>
                </div>
                <div class="col-md-6">
                  <label class="form-label" for="supply_quantity">Quantite</label>
                  <input id="supply_quantity" type="number" step="0.01" min="0.01" name="quantity" class="form-control" required="required" t-att-value="form_values.get('quantity', '1')"/>
                </div>
                <div class="col-12">
                  <label class="form-label" for="supply_reason">Motif</label>
                  <textarea id="supply_reason" name="reason" class="form-control" rows="4"><t t-out="form_values.get('reason', '')"/></textarea>
                </div>
              </t>
              <t t-else="">
                <div class="col-md-6">
                  <label class="form-label" for="attestation_type">Type d'attestation</label>
                  <select id="attestation_type" name="attestation_type" class="form-select" required="required">
                    <option value="">Selectionnez un type</option>
                    <option
                      t-foreach="attestation_types"
                      t-as="attestation_type"
                      t-att-value="attestation_type[0]"
                      t-att-selected="form_values.get('attestation_type') == attestation_type[0]"
                    ><t t-out="attestation_type[1]"/></option>
                  </select>
                </div>
                <div class="col-12">
                  <label class="form-label" for="attestation_reason">Motif</label>
                  <textarea id="attestation_reason" name="reason" class="form-control" rows="4"><t t-out="form_values.get('reason', '')"/></textarea>
                </div>
              </t>
              <div t-if="request_type in ('travel', 'supply')" class="col-md-6">
                <label class="form-label" for="estimated_cost">Cout estime</label>
                <input id="estimated_cost" type="number" step="0.01" min="0" name="estimated_cost" class="form-control" t-att-value="form_values.get('estimated_cost', '')"/>
              </div>
            </div>
            <div class="d-flex justify-content-between mt-4">
              <a class="btn btn-outline-secondary" t-att-href="default_url">Retour a la liste</a>
              <button type="submit" class="btn btn-primary">Creer la demande</button>
            </div>
          </form>
        </t>
      </t>
    </t>
  </template>

  <template id="portal_my_travel_requests" name="Mes deplacements">
    <t t-call="portail_rh.portal_request_list"/>
  </template>
  <template id="portal_travel_request_detail" name="Detail demande deplacement">
    <t t-call="portail_rh.portal_request_detail"/>
  </template>
  <template id="portal_new_travel_request" name="Nouvelle demande deplacement">
    <t t-call="portail_rh.portal_request_form"/>
  </template>
  <template id="portal_my_supply_requests" name="Mes fournitures">
    <t t-call="portail_rh.portal_request_list"/>
  </template>
  <template id="portal_supply_request_detail" name="Detail demande fourniture">
    <t t-call="portail_rh.portal_request_detail"/>
  </template>
  <template id="portal_new_supply_request" name="Nouvelle demande fourniture">
    <t t-call="portail_rh.portal_request_form"/>
  </template>
  <template id="portal_my_attestation_requests" name="Mes attestations">
    <t t-call="portail_rh.portal_request_list"/>
  </template>
  <template id="portal_attestation_request_detail" name="Detail demande attestation">
    <t t-call="portail_rh.portal_request_detail"/>
  </template>
  <template id="portal_new_attestation_request" name="Nouvelle demande attestation">
    <t t-call="portail_rh.portal_request_form"/>
  </template>

  <template id="portal_my_onboarding" name="Assistant d'integration">
    <t t-call="portal.portal_layout">
      <div class="rounded-4 bg-primary text-white p-4 p-lg-5 mb-4 shadow-sm">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div>
            <div class="text-white-50 small text-uppercase fw-bold mb-2">Atlas Digital Services</div>
            <h1 class="h2 mb-2">Bonjour <t t-out="employee.name"/> 👋</h1>
            <p class="mb-0 opacity-75">
              Votre assistant RH verifie les politiques internes avant de repondre.
              Posez une question simplement, en francais ou en anglais.
            </p>
          </div>
          <div class="text-lg-end">
            <div class="fw-bold"><t t-out="employee_job_name"/></div>
            <div class="opacity-75"><t t-out="employee_department_name"/></div>
          </div>
        </div>
      </div>
      <div t-if="success_message" class="alert alert-success" role="alert"><t t-out="success_message"/></div>
      <div t-if="error_message" class="alert alert-danger" role="alert"><t t-out="error_message"/></div>

      <div class="row g-4">
        <div class="col-lg-8">
          <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
              <strong>Demandez a Atlas Assistant</strong>
              <span class="badge text-bg-success">Sources verifiees</span>
            </div>
            <div class="card-body">
              <div t-if="not messages" class="alert alert-info mb-4">
                Posez une question sur votre integration, les horaires, les outils ou les procedures internes.
              </div>
              <div class="d-flex flex-column gap-3 mb-4">
                <t t-foreach="messages" t-as="chat_message">
                  <div t-attf-class="p-3 rounded #{'bg-primary text-white ms-lg-5' if chat_message.role == 'user' else 'bg-light me-lg-5'}">
                    <div class="small fw-bold mb-1">
                      <t t-if="chat_message.role == 'user'">Vous</t>
                      <t t-else="">Assistant</t>
                    </div>
                    <div style="white-space: pre-wrap"><t t-out="chat_message.content"/></div>
                    <t t-if="chat_message.role == 'assistant'">
                      <div t-if="message_sources.get(chat_message.id)" class="mt-3 pt-3 border-top">
                        <strong class="small">Sources</strong>
                        <ol class="small mb-0 mt-1">
                          <li t-foreach="message_sources.get(chat_message.id, [])" t-as="source">
                            <t t-out="source.get('title')"/> — <t t-out="source.get('section')"/>
                            (<t t-out="int(source.get('score', 0) * 100)"/>%)
                          </li>
                        </ol>
                      </div>
                      <div class="d-flex flex-wrap gap-2 mt-3">
                        <form action="/my/onboarding/feedback" method="post">
                          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                          <input type="hidden" name="message_id" t-att-value="chat_message.id"/>
                          <button name="feedback" value="helpful" type="submit" class="btn btn-sm btn-outline-success">Utile</button>
                          <button name="feedback" value="not_helpful" type="submit" class="btn btn-sm btn-outline-secondary">Pas utile</button>
                        </form>
                        <form t-if="chat_message.needs_escalation and not chat_message.escalation_activity_id" action="/my/onboarding/escalate" method="post">
                          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                          <input type="hidden" name="message_id" t-att-value="chat_message.id"/>
                          <button type="submit" class="btn btn-sm btn-outline-primary">Transmettre a RH</button>
                        </form>
                        <span t-if="chat_message.escalation_activity_id" class="badge text-bg-info align-self-center">Transmis a RH</span>
                      </div>
                    </t>
                  </div>
                </t>
              </div>
              <div class="mb-3">
                <div class="small text-muted fw-bold mb-2">Questions frequentes</div>
                <div class="d-flex flex-wrap gap-2">
                  <form t-foreach="suggested_questions" t-as="suggested_question" action="/my/onboarding/ask" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="question" t-att-value="suggested_question"/>
                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill">
                      <t t-out="suggested_question"/>
                    </button>
                  </form>
                </div>
              </div>
              <form action="/my/onboarding/ask" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <label for="onboarding_question" class="form-label fw-bold">Que souhaitez-vous savoir ?</label>
                <textarea id="onboarding_question" name="question" class="form-control form-control-lg" rows="3" maxlength="2000" required="required" placeholder="Ex. Puis-je teletravailler deux jours par semaine ?"></textarea>
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <small class="text-muted">Si aucune source ne couvre le sujet, vous pourrez contacter RH en un clic.</small>
                  <button type="submit" class="btn btn-primary px-4">Demander</button>
                </div>
              </form>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between">
              <strong>Ma checklist</strong>
              <span><t t-out="completed_task_count"/>/<t t-out="len(onboarding_tasks)"/></span>
            </div>
            <div class="list-group list-group-flush">
              <div t-if="not onboarding_tasks" class="list-group-item text-muted">Aucune tache assignee.</div>
              <div t-foreach="onboarding_tasks[:5]" t-as="task" class="list-group-item d-flex justify-content-between gap-2">
                <span t-att-class="'text-decoration-line-through text-muted' if task.state == 'done' else ''"><t t-out="task.plan_line_id.name"/></span>
                <span t-attf-class="badge #{'text-bg-success' if task.state == 'done' else ('text-bg-primary' if task.state == 'in_progress' else 'text-bg-secondary')}"><t t-out="task_state_labels.get(task.state)"/></span>
              </div>
            </div>
            <div class="card-footer bg-white">
              <a href="/my/onboarding/checklist" class="btn btn-outline-primary w-100">Voir toute la checklist</a>
            </div>
          </div>
          <div class="card shadow-sm">
            <div class="card-header bg-white"><strong>Liens rapides</strong></div>
            <div class="list-group list-group-flush">
              <a href="/my/travel_requests/new" class="list-group-item list-group-item-action">Nouvelle demande de deplacement</a>
              <a href="/my/supply_requests/new" class="list-group-item list-group-item-action">Nouvelle demande de fournitures</a>
              <a href="/my/attestation_requests/new" class="list-group-item list-group-item-action">Nouvelle demande d'attestation</a>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

  <template id="portal_onboarding_checklist" name="Checklist d'integration">
    <t t-call="portal.portal_layout">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="mb-1">Ma checklist d'integration</h2>
          <p class="text-muted mb-0"><t t-out="completed_task_count"/> etape(s) terminee(s) sur <t t-out="len(onboarding_tasks)"/>.</p>
        </div>
        <a href="/my/onboarding" class="btn btn-outline-secondary">Retour a l'assistant</a>
      </div>
      <div class="card shadow-sm">
        <div t-if="not onboarding_tasks" class="card-body text-muted">Aucun plan d'integration ne vous est encore assigne.</div>
        <div t-if="onboarding_tasks" class="list-group list-group-flush">
          <div t-foreach="onboarding_tasks" t-as="task" class="list-group-item p-3">
            <div class="d-flex flex-wrap justify-content-between gap-3">
              <div>
                <h5 t-att-class="'mb-1 text-decoration-line-through text-muted' if task.state == 'done' else 'mb-1'"><t t-out="task.plan_line_id.name"/></h5>
                <p t-if="task.plan_line_id.description" class="text-muted mb-0"><t t-out="task.plan_line_id.description"/></p>
                <span t-if="task.plan_line_id.required" class="badge text-bg-warning mt-2">Obligatoire</span>
              </div>
              <form t-att-action="'/my/onboarding/checklist/%s/state' % task.id" method="post" class="d-flex gap-2 align-items-center">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <select name="state" class="form-select form-select-sm">
                  <option value="todo" t-att-selected="task.state == 'todo'">A faire</option>
                  <option value="in_progress" t-att-selected="task.state == 'in_progress'">En cours</option>
                  <option value="done" t-att-selected="task.state == 'done'">Terminee</option>
                </select>
                <button type="submit" class="btn btn-sm btn-primary">Mettre a jour</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>
