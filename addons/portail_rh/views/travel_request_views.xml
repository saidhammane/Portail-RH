<odoo>
  <record id="view_hr_travel_request_search" model="ir.ui.view">
    <field name="name">hr.travel.request.search</field>
    <field name="model">hr.travel.request</field>
    <field name="arch" type="xml">
      <search string="Recherche demandes de déplacement">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="destination"/>
        <field name="state"/>
        <filter name="my_requests" string="Mes demandes" domain="[('employee_id.user_id', '=', uid)]"/>
        <separator/>
        <filter name="state_submitted" string="Soumis" domain="[('state', '=', 'submitted')]"/>
        <filter name="state_approved" string="Approuvées" domain="[('state', '=', 'approved')]"/>
        <filter name="state_rejected" string="Refusées" domain="[('state', '=', 'rejected')]"/>
        <filter name="state_done" string="Terminées" domain="[('state', '=', 'done')]"/>
        <separator/>
        <filter name="group_by_employee" string="Employé" context="{'group_by': 'employee_id'}"/>
        <filter name="group_by_state" string="État" context="{'group_by': 'state'}"/>
      </search>
    </field>
  </record>

  <record id="view_hr_travel_request_tree" model="ir.ui.view">
    <field name="name">hr.travel.request.tree</field>
    <field name="model">hr.travel.request</field>
    <field name="arch" type="xml">
      <tree string="Demandes de déplacement">
        <field name="name"/>
        <field name="employee_id"/>
        <field name="destination"/>
        <field name="date_from"/>
        <field name="date_to"/>
        <field name="estimated_cost"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="view_hr_travel_request_form" model="ir.ui.view">
    <field name="name">hr.travel.request.form</field>
    <field name="model">hr.travel.request</field>
    <field name="arch" type="xml">
      <form string="Demande de déplacement">
        <header>
          <button
            name="action_submit"
            type="object"
            string="Soumettre"
            class="btn-primary"
            invisible="state != 'draft'"
          />
          <button
            name="action_approve"
            type="object"
            string="Approuver"
            class="btn-primary"
            invisible="state != 'submitted' or not can_approve"
          />
          <button
            name="action_reject"
            type="object"
            string="Refuser"
            invisible="state != 'submitted' or not can_approve"
          />
          <button
            name="action_done"
            type="object"
            string="Terminer"
            class="btn-primary"
            invisible="state != 'approved' or not can_approve"
          />
          <button
            name="action_set_draft"
            type="object"
            string="Remettre en brouillon"
            invisible="state == 'draft' or (state != 'submitted' and not can_approve)"
          />
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected,done"/>
        </header>
        <sheet>
          <field name="can_approve" invisible="1"/>
          <group string="Employé">
            <field name="employee_id" domain="[('user_id','=',uid)]" readonly="state != 'draft'"/>
            <field name="department_id" readonly="1"/>
            <field name="manager_id" readonly="1"/>
          </group>
          <group string="Mission et dates">
            <field name="name" readonly="state != 'draft'"/>
            <field name="destination" readonly="state != 'draft'"/>
            <field name="date_from" readonly="state != 'draft'"/>
            <field name="date_to" readonly="state != 'draft'"/>
            <field name="duration_days" readonly="1"/>
          </group>
          <group string="Coût et motif">
            <field name="estimated_cost" readonly="state != 'draft'"/>
            <field name="purpose" readonly="state != 'draft'"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
</odoo>
