<odoo>
  <record id="view_hr_onboarding_document_tree" model="ir.ui.view">
    <field name="name">hr.onboarding.document.tree</field>
    <field name="model">hr.onboarding.document</field>
    <field name="arch" type="xml">
      <tree decoration-danger="indexing_state == 'error'" decoration-success="indexing_state == 'indexed'">
        <field name="name"/>
        <field name="category"/>
        <field name="language"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="department_id"/>
        <field name="visibility"/>
        <field name="version"/>
        <field name="indexing_state" widget="badge"/>
        <field name="indexed_at"/>
      </tree>
    </field>
  </record>

  <record id="view_hr_onboarding_document_form" model="ir.ui.view">
    <field name="name">hr.onboarding.document.form</field>
    <field name="model">hr.onboarding.document</field>
    <field name="arch" type="xml">
      <form string="Document d'integration">
        <header>
          <button name="action_reindex" string="Reindexer" type="object" class="btn-primary"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Archive" bg_color="text-bg-danger" invisible="active"/>
          <div class="oe_title"><h1><field name="name" placeholder="Titre du document"/></h1></div>
          <group>
            <group>
              <field name="file_name" invisible="1"/>
              <field name="file_data" filename="file_name"/>
              <field name="category"/>
              <field name="language"/>
              <field name="visibility"/>
            </group>
            <group>
              <field name="company_id"/>
              <field name="department_id"/>
              <field name="version"/>
              <field name="indexing_state" widget="badge"/>
              <field name="indexed_at"/>
              <field name="active" invisible="1"/>
            </group>
          </group>
          <group invisible="indexing_state != 'error'">
            <field name="error_message" readonly="1"/>
          </group>
          <field name="checksum" invisible="1"/>
          <field name="attachment_id" invisible="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_hr_onboarding_document_search" model="ir.ui.view">
    <field name="name">hr.onboarding.document.search</field>
    <field name="model">hr.onboarding.document</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="category"/>
        <field name="department_id"/>
        <filter name="pending" string="A indexer" domain="[('indexing_state', 'in', ('pending', 'error'))]"/>
        <separator/>
        <filter name="archived" string="Archives" domain="[('active', '=', False)]"/>
        <group expand="0" string="Regrouper par">
          <filter name="group_category" string="Categorie" context="{'group_by': 'category'}"/>
          <filter name="group_visibility" string="Visibilite" context="{'group_by': 'visibility'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_hr_onboarding_document" model="ir.actions.act_window">
    <field name="name">Documents d'integration</field>
    <field name="res_model">hr.onboarding.document</field>
    <field name="view_mode">tree,form</field>
    <field name="search_view_id" ref="view_hr_onboarding_document_search"/>
    <field name="groups_id" eval="[(6, 0, [ref('portail_rh.group_portail_rh_hr')])]"/>
  </record>

  <record id="view_hr_onboarding_plan_tree" model="ir.ui.view">
    <field name="name">hr.onboarding.plan.tree</field>
    <field name="model">hr.onboarding.plan</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="department_id"/>
        <field name="job_id"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_hr_onboarding_plan_form" model="ir.ui.view">
    <field name="name">hr.onboarding.plan.form</field>
    <field name="model">hr.onboarding.plan</field>
    <field name="arch" type="xml">
      <form string="Plan d'integration">
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <field name="department_id"/>
            <field name="job_id"/>
            <field name="active"/>
          </group>
          <notebook>
            <page string="Etapes">
              <field name="line_ids">
                <tree editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="name"/>
                  <field name="description"/>
                  <field name="required"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_hr_onboarding_plan" model="ir.actions.act_window">
    <field name="name">Plans d'integration</field>
    <field name="res_model">hr.onboarding.plan</field>
    <field name="view_mode">tree,form</field>
    <field name="groups_id" eval="[(6, 0, [ref('portail_rh.group_portail_rh_hr')])]"/>
  </record>

  <record id="view_hr_onboarding_employee_task_tree" model="ir.ui.view">
    <field name="name">hr.onboarding.employee.task.tree</field>
    <field name="model">hr.onboarding.employee.task</field>
    <field name="arch" type="xml">
      <tree decoration-success="state == 'done'">
        <field name="employee_id"/>
        <field name="plan_line_id"/>
        <field name="state" widget="badge"/>
        <field name="completed_at"/>
      </tree>
    </field>
  </record>

  <record id="view_hr_onboarding_employee_task_form" model="ir.ui.view">
    <field name="name">hr.onboarding.employee.task.form</field>
    <field name="model">hr.onboarding.employee.task</field>
    <field name="arch" type="xml">
      <form string="Checklist d'integration">
        <sheet>
          <group>
            <field name="employee_id"/>
            <field name="plan_line_id"/>
            <field name="state"/>
            <field name="completed_at"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_hr_onboarding_employee_task" model="ir.actions.act_window">
    <field name="name">Checklists collaborateurs</field>
    <field name="res_model">hr.onboarding.employee.task</field>
    <field name="view_mode">tree,form</field>
    <field name="groups_id" eval="[(6, 0, [ref('portail_rh.group_portail_rh_manager'), ref('portail_rh.group_portail_rh_hr')])]"/>
  </record>
</odoo>
