<odoo>
  <record id="module_category_portail_rh_core" model="ir.module.category">
    <field name="name">Portail RH</field>
    <field name="description">Groupes du socle Portail RH</field>
    <field name="sequence">20</field>
  </record>

  <record id="group_rh_portal_employee" model="res.groups">
    <field name="name">Portail RH - Employe</field>
    <field name="category_id" ref="module_category_portail_rh_core"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_rh_portal_manager" model="res.groups">
    <field name="name">Portail RH - Manager</field>
    <field name="category_id" ref="module_category_portail_rh_core"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_rh_portal_hr" model="res.groups">
    <field name="name">Portail RH - RH</field>
    <field name="category_id" ref="module_category_portail_rh_core"/>
    <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
  </record>
</odoo>
