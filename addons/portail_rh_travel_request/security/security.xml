<odoo>
  <record id="module_category_portail_rh_travel_request" model="ir.module.category">
    <field name="name">Portail RH</field>
    <field name="description">Travel request roles</field>
    <field name="sequence">30</field>
  </record>

  <record id="group_travel_request_user" model="res.groups">
    <field name="name">Travel Request User</field>
    <field name="category_id" ref="module_category_portail_rh_travel_request"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="group_travel_request_manager" model="res.groups">
    <field name="name">Travel Request Manager</field>
    <field name="category_id" ref="module_category_portail_rh_travel_request"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
</odoo>
