<odoo>
  <record id="travel_request_rule_user_own" model="ir.rule">
    <field name="name">Demande de deplacement: demandes personnelles</field>
    <field name="model_id" ref="model_portail_rh_travel_request"/>
    <field name="domain_force">['|', ('requester_user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <record id="travel_request_rule_manager_all" model="ir.rule">
    <field name="name">Demande de deplacement: le responsable voit tout</field>
    <field name="model_id" ref="model_portail_rh_travel_request"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('portail_rh_travel_request.group_travel_request_manager'))]"/>
  </record>
</odoo>
