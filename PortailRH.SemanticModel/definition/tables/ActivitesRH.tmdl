		displayFolder: Indicateurs
		lineageTag: c7e13040-9b27-4338-ba5d-e8195b4d4b2b

	measure 'Taux indexation' = DIVIDE([Documents indexes], [Documents IA], 0)
		formatString: 0.0%
		displayFolder: Indicateurs
		lineageTag: 3000fd95-5559-40b4-8bad-bcc7719807c0

