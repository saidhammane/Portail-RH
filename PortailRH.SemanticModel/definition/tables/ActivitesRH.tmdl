		displayFolder: Indicateurs
		lineageTag: 86d15216-673b-4290-b2b7-1f32545b48d0

	measure 'Questions IA' = CALCULATE(COUNTROWS(MessagesIA), MessagesIA[role] = "user")
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: 1822b8fa-3236-4d8f-9535-d5dc4200e779

	measure 'Reponses IA' = CALCULATE(COUNTROWS(MessagesIA), MessagesIA[role] = "assistant")
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: 54f1f5ff-11bc-4c01-a3e5-cce80090d263

	measure 'Confiance moyenne IA' = CALCULATE(AVERAGE(MessagesIA[confidence_score]), MessagesIA[role] = "assistant")
		formatString: 0.0%
		displayFolder: Indicateurs
		lineageTag: 0ec9f2dc-d72d-4167-b34e-b06f380a1675

	measure 'Latence moyenne IA' = CALCULATE(AVERAGE(MessagesIA[latency_ms]), MessagesIA[role] = "assistant")
		formatString: #,0 ms
		displayFolder: Indicateurs
		lineageTag: b71e010c-e1bb-4c99-bf82-288c8c26e09a

	measure 'Taux cache IA' = DIVIDE(CALCULATE([Reponses IA], MessagesIA[cache_hit] = 1), [Reponses IA], 0)
		formatString: 0.0%
		displayFolder: Indicateurs
		lineageTag: ca37a2c8-1f6a-4235-89ac-da01aa76a789

	measure 'Escalades RH' = CALCULATE([Reponses IA], MessagesIA[needs_escalation] = 1)
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: 9cf38262-cfea-4202-86ee-7ac4150aca30

	measure 'Taux escalade RH' = DIVIDE([Escalades RH], [Reponses IA], 0)
		formatString: 0.0%
		displayFolder: Indicateurs
		lineageTag: 2753d7b1-f543-4bbb-816f-3e7bdb95d0b8

	measure 'Feedbacks utiles' = CALCULATE([Reponses IA], MessagesIA[feedback] = "helpful")
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: 206b970c-60e4-49d6-81c8-60a554648992

	measure 'Feedbacks collectes' = CALCULATE([Reponses IA], NOT ISBLANK(MessagesIA[feedback]))
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: 4d74ef5f-1498-498d-bc98-8e09e5e33b74

	measure 'Taux feedback utile' = DIVIDE([Feedbacks utiles], [Feedbacks collectes], 0)
		formatString: 0.0%
		displayFolder: Indicateurs
		lineageTag: 251de55a-1be1-4fdf-a653-f5df2c40ec7c

	measure 'Documents IA' = COUNTROWS(DocumentsIA)
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: bad70b5c-5976-4de4-a577-5dfcc947c452

	measure 'Documents indexes' = CALCULATE([Documents IA], DocumentsIA[indexing_state] = "indexed")
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: fdda7688-25d9-4570-80ad-3dbdb357661f

	measure 'Documents en erreur' = CALCULATE([Documents IA], DocumentsIA[indexing_state] = "error")
