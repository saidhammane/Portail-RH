table ActivitesRH
	lineageTag: cdf620a9-973e-4a7f-bcc5-39f585dca475

	measure 'Total demandes' = COUNTROWS(ActivitesRH)
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: 5005b8bd-d1ff-46f5-8947-bb56d9f1895f

	measure 'Demandes approuvees' = CALCULATE([Total demandes], ActivitesRH[state] IN {"approved","done"})
		formatString: #,0
		displayFolder: Indicateurs
		lineageTag: 2c4ba067-6301-4f9b-80ba-77c94d9b4974

	measure 'Demandes en attente' = CALCULATE([Total demandes], ActivitesRH[state] = "submitted")
